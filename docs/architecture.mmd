graph TB
    subgraph CPU["CPU (core.h/cpp)"]
        CPU_IS["instr_socket&lt;br/&gt;simple_initiator"]
        CPU_DS["data_socket&lt;br/&gt;simple_initiator"]
    end

    subgraph Cache["Cache (unified I/D)"]
        Cache_TS["target_socket&lt;br/&gt;multi_passthrough_target"]
        Cache_IS["initiator_socket&lt;br/&gt;simple_initiator"]
    end

    subgraph IC["Interconnect"]
        IC_TS["target_socket&lt;br/&gt;multi_passthrough_target"]
        IC_MS["mem_socket&lt;br/&gt;simple_initiator"]
        IC_DMA["dma_mmio_socket&lt;br/&gt;simple_initiator"]
        IC_DIS["display_mmio_socket&lt;br/&gt;simple_initiator"]
    end

    subgraph MEM["Memory (8MB)"]
        MEM_TS["socket&lt;br/&gt;simple_target"]
    end

    subgraph DMA["DMA"]
        DMA_TS["target_socket&lt;br/&gt;simple_target (MMIO)"]
        DMA_IS["initiator_socket&lt;br/&gt;simple_initiator"]
    end

    subgraph DIS["Display"]
        DIS_TS["target_socket&lt;br/&gt;simple_target (MMIO)"]
        DIS_IS["initiator_socket&lt;br/&gt;simple_initiator"]
    end

    CPU_IS -->|fetch| Cache_TS
    CPU_DS -->|load/store| Cache_TS
    Cache_IS -->|"all traffic"| IC_TS
    DMA_IS -->|"data transfer"| IC_TS
    DIS_IS -->|"framebuffer read"| IC_TS

    IC_MS -->|"0x80000000"| MEM_TS
    IC_DMA -->|"0x10000000 (MMIO)"| DMA_TS
    IC_DIS -->|"0x10001000 (MMIO)"| DIS_TS

    style CPU_IS fill:#e1d5e7,stroke:#9673a6
    style CPU_DS fill:#e1d5e7,stroke:#9673a6
    style Cache_IS fill:#e1d5e7,stroke:#9673a6
    style IC_MS fill:#e1d5e7,stroke:#9673a6
    style IC_DMA fill:#e1d5e7,stroke:#9673a6
    style IC_DIS fill:#e1d5e7,stroke:#9673a6
    style DMA_IS fill:#e1d5e7,stroke:#9673a6
    style DIS_IS fill:#e1d5e7,stroke:#9673a6

    style Cache_TS fill:#f8cecc,stroke:#b85450
    style IC_TS fill:#f8cecc,stroke:#b85450
    style MEM_TS fill:#f8cecc,stroke:#b85450
    style DMA_TS fill:#f8cecc,stroke:#b85450
    style DIS_TS fill:#f8cecc,stroke:#b85450

    style CPU fill:#dae8fc,stroke:#6c8ebf
    style Cache fill:#d5e8d4,stroke:#82b366
    style IC fill:#fff2cc,stroke:#d6b656
    style MEM fill:#f5f5f5,stroke:#666666
    style DMA fill:#ffe6cc,stroke:#d79b00
    style DIS fill:#e1d5e7,stroke:#9673a6
